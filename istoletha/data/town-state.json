  "sagas": [
    {
      "id": "the-question-of-the-address",
      "title": "The Question of the Address",
      "status": "ongoing",
      "openedOn": "2025-10-02",
      "lastBeat": "2025-10-03",
      "beats": [
        {
          "date": "2025-10-02",
          "text": "Amended four times in eighty minutes and returned, exhausted, to its original form.",
          "origin": "74b3722"
        },
        {
          "date": "2025-10-03",
          "text": "The address was amended once more, this time inside the Clerk's own paperwork.",
          "origin": "5f71be9"
        }
      ]
    },
    {
      "id": "the-clerks-litany",
      "title": "The Clerk's Litany",
      "status": "resolved",
      "openedOn": "2025-10-03",
      "lastBeat": "2026-07-11",
      "beats": [
        {
          "date": "2025-10-03",
          "text": "Filed the same notice twice on its first day. Both filings were correct.",
          "origin": "0033075"
        },
        {
          "date": "2026-04-02",
          "text": "Resumed after one hundred and seventy-eight days, at precisely the point it left off.",
          "origin": "eed6d13"
        },
        {
          "date": "2026-04-03",
          "text": "Filed six times in one day. Did not vary. Did not tire. Did not comment.",
          "origin": "45967b5"
        },
        {
          "date": "2026-05-05",
          "text": "Answered each report the instant it arrived. Has now filed more notices than the town has had visitors.",
          "origin": "b438bd4"
        },
        {
          "date": "2026-07-10",
          "text": "Filed twice. There was nothing to file about. It filed anyway, and it filed correctly.",
          "origin": "cdf3000"
        },
        {
          "date": "2026-07-11",
          "text": "The Clerk's office was struck from the plan. Fifteen filings stand in the Register. They will not be added to. The matter is closed. The Clerk was not informed.",
          "origin": "8993f2e"
        }
      ]
    },
    {
      "id": "the-quiet-season",
      "title": "The Quiet Season",
      "status": "resolved",
      "openedOn": "2026-04-02",
      "lastBeat": "2026-04-02",
      "beats": [
        {
          "date": "2026-04-02",
          "text": "One hundred and seventy-eight days of silence, ended without explanation on a Thursday evening.",
          "origin": "04e3fd6"
        }
      ]
    },
    {
      "id": "the-annexed-territories",
      "title": "The Annexed Territories",
      "status": "ongoing",
      "openedOn": "2026-04-19",
      "lastBeat": "2026-05-05",
      "beats": [
        {
          "date": "2026-04-19",
          "text": "Three territories annexed. They govern themselves, keep their own records, and write when it suits them.",
          "origin": "372f3a8"
        },
        {
          "date": "2026-05-05",
          "text": "Four reports from Tinker Tides, accepted without inspection. The Office has no inspector.",
